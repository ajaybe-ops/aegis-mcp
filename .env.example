# Aegis MCP local development defaults. Copy to .env and adjust.
# All settings use the AEGIS_ prefix (pydantic-settings).

AEGIS_ENVIRONMENT=development
AEGIS_TRANSPORT=stdio
AEGIS_HOST=127.0.0.1
AEGIS_PORT=8000
AEGIS_MCP_PATH=/mcp
AEGIS_PUBLIC_URL=http://localhost:8000

AEGIS_AUTH_MODE=local
AEGIS_JWT_SECRET=
AEGIS_JWT_ALGORITHMS=HS256
AEGIS_JWT_ISSUER=https://aegis.local
AEGIS_JWT_AUDIENCE=
AEGIS_JWT_JWKS_URL=
AEGIS_JWT_LEEWAY_SECONDS=30
AEGIS_REQUIRED_SCOPES=aegis:read
AEGIS_LOCAL_SCOPES=aegis:read,aegis:triage
AEGIS_ALLOWED_HOSTS=localhost:*,127.0.0.1:*,[::1]:*
AEGIS_ALLOWED_ORIGINS=http://localhost:*,http://127.0.0.1:*,http://[::1]:*

AEGIS_READ_RATE_PER_MINUTE=60
AEGIS_READ_BURST=15
AEGIS_TRIAGE_RATE_PER_MINUTE=10
AEGIS_TRIAGE_BURST=3
AEGIS_MAX_UPSTREAM_CONCURRENCY=8
AEGIS_MAX_TRIAGE_CONCURRENCY=5

AEGIS_UPSTREAM_TIMEOUT_SECONDS=8.0
AEGIS_UPSTREAM_CONNECT_TIMEOUT_SECONDS=3.0
AEGIS_MAX_RETRIES=3
AEGIS_RETRY_BASE_DELAY_SECONDS=0.15
AEGIS_RETRY_MAX_DELAY_SECONDS=2.0
AEGIS_CIRCUIT_FAILURE_THRESHOLD=5
AEGIS_CIRCUIT_RESET_SECONDS=30.0
AEGIS_MAX_UPSTREAM_RESPONSE_BYTES=2097152
AEGIS_NVD_API_KEY=

AEGIS_CACHE_TTL_SECONDS=300
AEGIS_KEV_CACHE_TTL_SECONDS=3600
AEGIS_CACHE_MAX_ENTRIES=2048
AEGIS_USER_AGENT=aegis-mcp/0.1.0

AEGIS_SQLITE_PATH=data/aegis.db

AEGIS_OTEL_ENABLED=false
AEGIS_OTEL_ENDPOINT=
AEGIS_OTEL_SERVICE_NAME=aegis-mcp
AEGIS_OTEL_CONSOLE_EXPORT=false

AEGIS_OFFLINE=true
